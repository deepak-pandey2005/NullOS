#!/usr/bin/env bash
# NullOS SDK Standard Compiler Driver (Musl-based)
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SDK_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
SDK_INC="${SDK_ROOT}/include"

CC="musl-gcc"
EXTRA_FLAGS=("-I${SDK_INC}" "-static")

exec "${CC}" "${EXTRA_FLAGS[@]}" "$@"
